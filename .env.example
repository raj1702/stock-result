# Generate a long random value; never commit the real secret.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=replace-with-user-pool-id
COGNITO_CLIENT_ID=replace-with-app-client-id
COGNITO_CLIENT_SECRET=replace-with-app-client-secret
COGNITO_DOMAIN=https://replace-with-prefix.auth.ap-south-1.amazoncognito.com
COGNITO_REDIRECT_URI=https://replace-with-cloudfront-domain/auth/callback
COGNITO_LOGOUT_URI=https://replace-with-cloudfront-domain/
PUBLIC_BASE_URL=https://replace-with-cloudfront-domain

AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=earnings-assistant
# Production only. Leave unset locally to continue loading secrets from .env.
AWS_SECRETS_MANAGER_SECRET_ID=earnings-assistant/prod/app

# Start with Test Mode keys. Use Live Mode keys only after end-to-end testing.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace-with-key-id
RAZORPAY_KEY_SECRET=replace-with-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-an-independent-webhook-secret
